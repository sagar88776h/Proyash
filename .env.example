# ---------------------------------------------------------------------------
# PRAYASH website — browser build configuration (copy to .env.local)
#
# Everything here is PUBLIC: it is compiled into JavaScript that every visitor
# downloads. Never put the service-role key, database password, SMTP password
# or Turnstile secret here. The build refuses to start if a service-role or
# sb_secret_ key is detected.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (Project Settings → API). Public by design;
# Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=

# Public address of the website, used for sign-in email links.
# Optional: defaults to the address the site is opened on.
VITE_SITE_URL=https://www.example.org

# Cloudflare Turnstile SITE key (optional). Leave empty to disable the widget.
# If set, also set TURNSTILE_SECRET_KEY as an Edge Function secret.
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Edge Function secrets — DO NOT put these in .env.local or in Vercel.
# Set them with:  supabase secrets set NAME=value
#
#   ALLOWED_ORIGINS        Comma-separated site origins allowed to call the
#                          functions, e.g. https://www.example.org,https://example.org
#   STAFF_SITE_URL         Public site URL used in invitation links
#   RATE_LIMIT_SALT        Long random string used to hash IP addresses and
#                          phone numbers for rate limiting (openssl rand -hex 32)
#   TURNSTILE_SECRET_KEY   Cloudflare Turnstile secret (only if the site key is set)
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to Edge Functions automatically by Supabase.
# ---------------------------------------------------------------------------
