{
  "name": "prayash-web",
  "private": true,
  "version": "0.1.0",
  "description": "PRAYASH \u2014 community welfare platform (public website + secure administration)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions/public-api/index.ts supabase/functions/staff-api/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:functions": "vitest run --project functions",
    "test:e2e": "playwright test",
    "db:types": "node scripts/gen-db-types.mjs",
    "stack:start": "node scripts/local-stack/start.mjs",
    "stack:stop": "node scripts/local-stack/stop.mjs",
    "stack:reset": "node scripts/local-stack/reset-db.mjs",
    "provision-admin": "node scripts/provision-admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "framer-motion": "13.4.4",
    "gsap": "3.15.0",
    "lucide-react": "1.48.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "deno": "2.9.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jose": "6.2.12",
    "jsdom": "27.4.0",
    "mailparser": "3.9.31",
    "pg": "8.23.0",
    "prettier": "3.8.1",
    "smtp-server": "3.19.15",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
